#!/usr/bin/env grease
# Requirements: the exact source checkout, recorded Grease host runtime, pinned
# Idriç compiler with its own contrib, qualified ICK, and accepted FP/Kn/CF/AICI
# checkouts. A real provider refusal must remain a failing provider stage.
if (int($#) !== 1) {
  echo 'usage: amazon-jobs-acceptance.grease bootstrap|fixtures|diagnostics|accept' >&2
  exit 2
}
var root = "$(git rev-parse --show-toplevel)"
var compiler = "$root/Idric/_/build/exec/idris2"
var mode = $1
if (mode === 'bootstrap') {
  cd -- "$root/Idric"
  # Bootstrap must derive its own hidden-root prefix before top-level links exist.
  env -u IDRIS2_PREFIX -u IDRIS2_PATH JOBS=2 ./_/edric all
  make -C _/libs/contrib install IDRIS2="$compiler" \
    IDRIS2_PREFIX="$root/Idric/_/bootstrap-build" \
    IDRIS2_PATH="$root/Idric/_/libs/contrib/build/ttc:$root/Idric/_/libs/base/build/ttc"
} elif (mode === 'fixtures') {
  cd -- "$root"
  "$compiler" --version
  "$compiler" -p contrib checkpoints/amazon-jobs/AmazonJobs.idric -o amazon-jobs
  ./build/exec/amazon-jobs --self-test
  ./build/exec/amazon-jobs --help | grep -F -- '--all'
  sha256sum checkpoints/amazon-jobs/AmazonJobs.idric build/exec/amazon-jobs
  try { ./build/exec/amazon-jobs --all --max-years 0 }
  var narrowed = _error.code
  if (narrowed === 0) {
    echo 'FAIL: census accepted a silently narrowed denominator' >&2
    exit 1
  }
  try { ./build/exec/amazon-jobs --format nonsense }
  var unknown = _error.code
  if (unknown === 0) {
    echo 'FAIL: unknown output format accepted' >&2
    exit 1
  }
} elif (mode === 'diagnostics') {
  var output = "$root/.acceptance/diagnostic"
  mkdir -p "$output"
  cd -- "$root"
  "$compiler" --build-dir build/response-fixture \
    examples/autogenerated/amazon-response-capture/InvalidResponse.idric -o curl
  printf '%s\n' 'synthetic invalid response <diagnostic-negative>' > "$output/expected.txt"
  try {
    env PATH="$root/build/response-fixture/exec:$[ENV.PATH]" \
      AMAZON_JOBS_FAILURE_RESPONSE="$output/response.txt" \
      "$root/build/exec/amazon-jobs" diagnostic-negative --limit 1 \
      > "$output/stdout" 2> "$output/stderr"
  }
  var result = _error.code
  test "$result" = 1
  cmp "$output/expected.txt" "$output/response.txt"
  grep -F 'search endpoint returned invalid JSON' "$output/stderr"
  grep -F 'curl_process_status' "$output/response.txt.request.tsv"
  grep -F 'offset' "$output/response.txt.request.tsv"
  test ! -s "$output/stdout"
} elif (mode === 'accept') {
  var ick = get(ENV, 'ICK') or ''
  var head = "$(git -C "$root" rev-parse HEAD)"
  var grease = "$root/.acceptance/grease/bin/grease"
  test -x "$compiler"
  test -x "$ick"
  mkdir -p "$root/.acceptance/workspace" "$root/.acceptance/bin" "$root/.acceptance/receipts"
  # Cat Food owns the stable command link; this only gives it the exact source.
  ln -s "$root" "$root/.acceptance/workspace/idric-cli"
  "$ick" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O2 \
    "$root/.acceptance/aici/src/aici.c" -o "$root/.acceptance/bin/aici"
  cd -- "$root/.acceptance/aici"
  "$root/.acceptance/bin/aici" self-test tests/cases.tsv
  cd -- "$root/.acceptance/fp"
  env AMAZON_JOBS_FAILURE_RESPONSE="$root/.acceptance/receipts/provider-failure-response.txt" \
    python3 ./scripts/run-pipeline amazon-jobs-org-audit \
    --runs-root "$root/.acceptance/receipts" \
    --param "program=$root/.acceptance/workspace/bin/amazon-jobs" \
    --param "cli-source=$root/checkpoints/amazon-jobs/AmazonJobs.idric" \
    --param "cli-root=$root" \
    --param "cli-head=$head" \
    --param "catfood-manifest=$root/.acceptance/catfood/tools.tsv" \
    --param "historic-snapshot=$root/.acceptance/blackball/FAANG/amazon/inventory/2026-09-16T155726Z/jobs.tsv" \
    --param "aici=$root/.acceptance/bin/aici" \
    --param "aici-contract=$root/.acceptance/aici/contracts/amazon-jobs-cli-v0.contract.tsv" \
    --param "aici-source=$root/.acceptance/aici/src/aici.c" \
    --param "grease=$grease" \
    --param "kitchen-task=$root/.acceptance/kitchen/tasks/amazon-jobs-cli/2.grease" \
    --param "idric-compiler=$compiler" \
    --param "catfood-update=$root/.acceptance/catfood/update-tools.ysh" \
    --param "catfood-workspace=$root/.acceptance/workspace"
} else {
  echo 'mode must be bootstrap, fixtures, diagnostics or accept' >&2
  exit 2
}
